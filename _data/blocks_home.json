[
  {
    "id": "hero",
    "nome": "Hero",
    "enabled": true,
    "html": "<link rel=\"preconnect\" href=\"https://fonts.googleapis.com\"><link href=\"https://fonts.googleapis.com/css2?family=Archivo+Narrow:wght@500;600;700&display=swap\" rel=\"stylesheet\">\n<style>\n#main-content{--ink:#15191d;--line:#eadfd2;--warm:#fbf3ea;--muted:#54483c;--y:#ff8a1f;--gd:#d9480f;--deep:#7c2d0a;--d:'Archivo Narrow','Arial Narrow',sans-serif;--ease:cubic-bezier(.16,1,.3,1)}\n#main-content ::selection{background:#ff8a1f;color:#15191d}\n.ex-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:.8rem 1.6rem;font-family:var(--d);font-weight:700;font-size:1.05rem;border-radius:2px;text-decoration:none;border:1px solid transparent;transition:background-color .2s var(--ease),border-color .2s var(--ease)}\n.ex-btn:focus-visible{outline:3px solid var(--ink);outline-offset:3px}.ex-end .ex-btn:focus-visible{outline-color:var(--y)}\n.ex-btn-y{background:var(--y);color:var(--ink)}.ex-btn-y:hover{background:#ffb347}\n.ex-btn-o{border-color:#8b9580;color:var(--ink)}.ex-btn-o:hover{border-color:var(--ink)}\n.ex-btn-k{background:var(--ink);color:#fff}.ex-btn-k:hover{background:#2a323a}\n.ex-band .ex-btn:focus-visible{outline-color:var(--ink)}\n.ex-hero{background:#eef3e4;color:var(--ink);box-sizing:border-box;display:flex;align-items:center;min-height:calc(100vh - 80px);min-height:calc(100svh - 80px);padding:clamp(1.5rem,4vh,4rem) 1.5rem}\n.ex-hero-in{width:100%;max-width:1180px;margin:0 auto;display:grid;grid-template-columns:1.2fr 1fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-hero h1{font-family:var(--d);font-weight:700;font-size:clamp(2.5rem,5.4vw,4.4rem);line-height:1;letter-spacing:-.01em;color:var(--ink);margin:0 0 1.5rem;max-width:17ch;text-wrap:balance}\n.ex-hero p{font-size:1.1rem;line-height:1.6;color:#3d444a;max-width:46ch;margin:0 0 2rem}\n.ex-actions{display:flex;gap:1rem;flex-wrap:wrap}\n.ex-fig{margin:0;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,.8fr);gap:1.5rem;align-items:stretch}\n.ex-fig svg{width:100%;height:auto;max-height:min(520px,calc(100svh - 11rem));display:block}\n.ex-stats{display:flex;flex-direction:column;justify-content:space-between;padding:0 0 1.5rem;margin:0;list-style:none}\n.ex-stats li{border-top:1px solid #b9c4a6;padding-top:.75rem;margin:0}\n.ex-num{display:block;font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,2.8rem);line-height:1;color:var(--gd);font-variant-numeric:tabular-nums}\n.ex-lab{display:block;font-size:.92rem;line-height:1.4;color:#54483c;margin-top:.35rem}\n.ex-rope,.ex-rope2{stroke-dasharray:1;animation:ex-draw 1.8s var(--ease) both}\n.ex-man{animation:ex-drop 1.8s var(--ease) both}.ex-sway{transform-origin:0 -60px;animation:ex-sway 4.2s ease-in-out 1.8s infinite alternate}.ex-legs{transform-origin:0 2px;animation:ex-push 2.6s ease-in-out 1.8s infinite alternate}\n@keyframes ex-draw{from{stroke-dashoffset:1}to{stroke-dashoffset:0}}\n@keyframes ex-drop{from{transform:translateY(-222px)}}@keyframes ex-sway{from{transform:rotate(-1.4deg)}to{transform:rotate(1.4deg)}}@keyframes ex-push{from{transform:rotate(0)}to{transform:rotate(-4deg)}}\n@media (prefers-reduced-motion:reduce){.ex-rope,.ex-rope2,.ex-man,.ex-sway,.ex-legs{animation:none}}\n.ex-sec{padding:clamp(3.5rem,8vw,6.5rem) 1.5rem;background:#fff}\n.ex-sec-warm{background:var(--warm)}\n.ex-wrap{max-width:1180px;margin:0 auto}\n.ex-h2{font-family:var(--d);font-weight:700;font-size:clamp(2rem,3.4vw,3rem);line-height:1.08;color:var(--ink);margin:0;text-wrap:balance}\n.ex-2col{display:grid;grid-template-columns:1fr 1.3fr;gap:clamp(2rem,5vw,4.5rem);align-items:start}\n.ex-lead{font-size:1.1rem;line-height:1.65;color:var(--muted);max-width:38ch;margin:1.25rem 0 0}\n.ex-pts{list-style:none;margin:0;padding:0}\n.ex-pts li{padding:1.25rem 0;border-top:1px solid #d6d3c9;margin:0}.ex-pts li:last-child{border-bottom:1px solid #d6d3c9}\n.ex-pts b{display:block;font-family:var(--d);font-size:1.35rem;line-height:1.2;color:var(--ink);margin-bottom:.3rem}\n.ex-pts span{font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:2.5rem;margin-top:3rem}\n.ex-grid3>div{border-top:2px solid var(--ink);padding-top:1rem}\n.ex-grid3 h3{font-family:var(--d);font-size:1.35rem;font-weight:700;color:var(--ink);margin:0 0 .4rem;line-height:1.2}\n.ex-grid3 p{margin:0;font-size:1rem;line-height:1.6;color:var(--muted)}\n.ex-svc-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;flex-wrap:wrap;padding-bottom:1.75rem;border-bottom:2px solid var(--ink)}\n.ex-svc-head p{margin:0;color:var(--muted);max-width:34ch;font-size:1.02rem;line-height:1.5}\n.ex-svcs{display:grid;grid-template-columns:repeat(2,1fr);column-gap:3rem}\n.ex-svc{display:grid;grid-template-columns:1fr auto;gap:.25rem 1rem;align-items:center;padding:1.3rem .25rem;border-bottom:1px solid var(--line);text-decoration:none;color:inherit;transition:background-color .2s var(--ease),padding .2s var(--ease)}\n.ex-svc:hover{background:var(--warm);padding-left:.9rem}\n.ex-svc:focus-visible{outline:3px solid var(--ink);outline-offset:-3px}\n.ex-svc-t{font-family:var(--d);font-weight:700;font-size:1.25rem;line-height:1.2;color:var(--ink)}\n.ex-svc-d{grid-column:1;font-size:.95rem;line-height:1.5;color:var(--muted)}\n.ex-svc svg{grid-column:2;grid-row:1/span 2;width:20px;height:20px;stroke:var(--ink);fill:none;stroke-width:2;transition:transform .2s var(--ease)}\n.ex-svc:hover svg{transform:translateX(4px)}\n.ex-band{background:var(--y);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-end{background:var(--deep);padding:clamp(3rem,6vw,4.5rem) 1.5rem}\n.ex-band-in{max-width:1180px;margin:0 auto;display:flex;justify-content:space-between;align-items:center;gap:2rem;flex-wrap:wrap}\n.ex-band p{margin:.6rem 0 0;color:#2c3136;font-size:1.1rem;line-height:1.5}\n.ex-end .ex-h2{color:#fff}.ex-end p{margin:.6rem 0 0;color:#d7e2c6;font-size:1.1rem;line-height:1.5}\n@media (max-width:820px){.ex-hero-in,.ex-2col{grid-template-columns:1fr}.ex-fig{max-width:440px}.ex-grid3{grid-template-columns:1fr 1fr}.ex-svcs{grid-template-columns:1fr}}\n@media (max-width:560px){.ex-grid3{grid-template-columns:1fr}.ex-sec,.ex-hero,.ex-band,.ex-end{padding-left:1.25rem;padding-right:1.25rem}}\n</style>\n<header class=\"ex-hero\" aria-label=\"Hero\"><div class=\"ex-hero-in\"><div><h1>Tetti e facciate, senza ponteggio.</h1><p>Grondaie, coperture, facciate e messa in sicurezza eseguite da operatori addestrati che si calano dall'alto con la fune: arriviamo dove scale e piattaforme faticano, senza impalcature davanti a finestre e ingressi.</p><div class=\"ex-actions\"><a class=\"ex-btn ex-btn-y\" href=\"#pricing\" onclick=\"trackClick('edilextreme','preventivo-hero','Preventivo',0)\">Chiedi un preventivo</a><a class=\"ex-btn ex-btn-o\" href=\"#servizi\">Scopri i servizi</a></div></div><figure class=\"ex-fig\"><svg viewBox=\"0 0 300 520\" role=\"img\" aria-label=\"Operatore su fune che scende lungo la facciata di un edificio, senza ponteggio\"><line x1=\"0\" y1=\"500\" x2=\"300\" y2=\"500\" stroke=\"#b3a08c\" stroke-width=\"2\"/><rect x=\"40\" y=\"60\" width=\"220\" height=\"440\" fill=\"#e3e9d6\" stroke=\"#b3a08c\" stroke-width=\"2\"/><rect x=\"32\" y=\"52\" width=\"236\" height=\"10\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"96\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"96\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"96\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"96\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"154\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"154\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"154\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"154\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"212\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"212\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"212\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"212\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"270\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"270\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"270\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"270\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"328\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"328\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"328\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"328\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"386\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"386\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"386\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"386\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"64\" y=\"444\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"112\" y=\"444\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"160\" y=\"444\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"208\" y=\"444\" width=\"28\" height=\"40\" fill=\"#e0d3c2\" stroke=\"#b3a08c\"/><rect x=\"146\" y=\"38\" width=\"16\" height=\"14\" rx=\"2\" fill=\"#ff8a1f\" stroke=\"#d9480f\" stroke-width=\"2\"/><path class=\"ex-rope2\" pathLength=\"1\" d=\"M168 52V304\" fill=\"none\" stroke=\"#8f7d6b\" stroke-width=\"2\"/><path class=\"ex-rope\" pathLength=\"1\" d=\"M154 52V330\" fill=\"none\" stroke=\"#2a323a\" stroke-width=\"3\"/><g transform=\"translate(154 330) scale(1.25)\"><g class=\"ex-man\"><g class=\"ex-sway\"><ellipse cx=\"14\" cy=\"8\" rx=\"28\" ry=\"50\" fill=\"#15191d\" opacity=\".08\"/><g class=\"ex-legs\"><path d=\"M-7 2L-19 22L-14 42M7 2L19 22L14 40\" fill=\"none\" stroke=\"#3b4a5a\" stroke-width=\"9\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><ellipse cx=\"-14\" cy=\"46\" rx=\"8\" ry=\"4.5\" fill=\"#1c2125\"/><ellipse cx=\"14\" cy=\"44\" rx=\"8\" ry=\"4.5\" fill=\"#1c2125\"/></g><path d=\"M0 2C-2 14 4 24 -2 34\" fill=\"none\" stroke=\"#2a323a\" stroke-width=\"2.5\" stroke-linecap=\"round\"/><rect x=\"-14\" y=\"-8\" width=\"28\" height=\"9\" rx=\"3\" fill=\"#2a323a\"/><path d=\"M-14 -33Q0 -38 14 -33L12 -6H-12Z\" fill=\"#ff8a1f\"/><path d=\"M-9 -34L5 -9M9 -34L-5 -9\" fill=\"none\" stroke=\"#15191d\" stroke-width=\"2.5\"/><rect x=\"-13\" y=\"-16\" width=\"26\" height=\"4\" fill=\"#f8efe4\"/><rect x=\"-9\" y=\"-31\" width=\"18\" height=\"11\" rx=\"3\" fill=\"#2f3a42\"/><path d=\"M-13 -30L-19 -46L-3 -64\" fill=\"none\" stroke=\"#e8710a\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"-1\" cy=\"-65\" r=\"4\" fill=\"#2a323a\"/><path d=\"M13 -30L20 -16L9 -5\" fill=\"none\" stroke=\"#e8710a\" stroke-width=\"7\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/><circle cx=\"8\" cy=\"-4\" r=\"4\" fill=\"#2a323a\"/><rect x=\"-3.5\" y=\"-38\" width=\"7\" height=\"7\" rx=\"2\" fill=\"#c98f6b\"/><path d=\"M-11 -41a11 10 0 0 1 22 0v3h-22z\" fill=\"#ffffff\" stroke=\"#cdbfae\"/><rect x=\"-2.5\" y=\"-51\" width=\"5\" height=\"12\" fill=\"#ff8a1f\"/><rect x=\"-12\" y=\"-40\" width=\"24\" height=\"3\" rx=\"1.5\" fill=\"#eadfd2\"/></g></g></g></svg><ul class=\"ex-stats\"><li><b class=\"ex-num\">Fino a &minus;40%</b><span class=\"ex-lab\">di spesa in meno rispetto al ponteggio, a seconda dell'intervento</span></li><li><b class=\"ex-num\">24 h</b><span class=\"ex-lab\">per risponderti, esclusi i giorni festivi</span></li><li><b class=\"ex-num\">0</b><span class=\"ex-lab\">ponteggi da montare, nessuna impalcatura</span></li></ul></figure></div></header>"
  },
  {
    "id": "whatis",
    "nome": "Perché lavorare su fune",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"whatis\" aria-labelledby=\"whatis-title\"><div class=\"ex-wrap ex-2col\"><div><h2 class=\"ex-h2\" id=\"whatis-title\">Perché scegliere la fune</h2><p class=\"ex-lead\">Le tecniche di accesso e posizionamento su fune nascono dall'alpinismo e consentono di raggiungere qualunque edificio senza aspettare il montaggio di un ponteggio e senza sostenerne il costo.</p></div><ol class=\"ex-pts\"><li><b>Si va dritti al problema</b><span>gli operatori raggiungono il punto esatto da sistemare, anche negli angoli più scomodi della facciata.</span></li><li><b>Nessuna struttura da montare</b><span>niente nolo di ponteggi, trabattelli o piattaforme aeree.</span></li><li><b>Costi più contenuti</b><span>fino al 40% in meno, come stima indicativa: il risparmio nasce dal fatto che non si paga l'impalcatura né i giorni per allestirla.</span></li><li><b>Pratiche più leggere</b><span>di norma servono meno permessi e meno carte che in un cantiere con ponteggio.</span></li></ol></div></section>"
  },
  {
    "id": "stack",
    "nome": "Sei motivi per fidarsi",
    "enabled": true,
    "html": "<section class=\"ex-sec ex-sec-warm\" id=\"stack\" aria-labelledby=\"stack-title\"><div class=\"ex-wrap\"><h2 class=\"ex-h2\" id=\"stack-title\">Sei buoni motivi per sceglierci</h2><div class=\"ex-grid3\"><div><h3>Prima di tutto la sicurezza</h3><p>Ogni operatore lavora con due funi indipendenti e con dispositivi anticaduta, dopo una formazione specifica.</p></div><div><h3>Dove il ponteggio non conviene</h3><p>Balconi, gronde, comignoli e pareti alte: raggiungiamo anche gli angoli più complicati.</p></div><div><h3>Costi trasparenti</h3><p>Il sopralluogo è gratuito e il preventivo arriva per iscritto, senza voci per nolo di impalcature o mezzi.</p></div><div><h3>Tempi brevi</h3><p>Trovato un ancoraggio affidabile si parte, spesso senza dover attendere l'allestimento del cantiere.</p></div><div><h3>Poco disturbo</h3><p>Finestre e balconi restano liberi: chi vive o lavora nell'edificio può continuare a usarlo normalmente.</p></div><div><h3>Ti seguiamo fino in fondo</h3><p>Dal primo consiglio alla verifica a lavoro finito, hai sempre un riferimento a cui rivolgerti.</p></div></div></div></section>"
  },
  {
    "id": "features",
    "nome": "Servizi",
    "enabled": true,
    "html": "<section class=\"ex-sec\" id=\"servizi\" aria-labelledby=\"features-title\"><div class=\"ex-wrap\"><div class=\"ex-svc-head\"><h2 class=\"ex-h2\" id=\"features-title\">I nostri servizi</h2><p>Un unico modo di lavorare: si scende dall'alto, l'impalcatura non serve.</p></div><div class=\"ex-svcs\"><a class=\"ex-svc\" href=\"/servizi/impermeabilizzazione-su-fune/\"><span class=\"ex-svc-t\">Impermeabilizzazione su fune</span><span class=\"ex-svc-d\">Terrazzi, coperture e lastre rese di nuovo a tenuta contro pioggia e infiltrazioni.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/riparazione-e-pulizia-grondaie/\"><span class=\"ex-svc-t\">Riparazione e pulizia grondaie</span><span class=\"ex-svc-d\">Canali e pluviali liberati dai residui, con sistemazione o cambio dei pezzi rovinati.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/montaggio-isolanti/\"><span class=\"ex-svc-t\">Montaggio isolanti</span><span class=\"ex-svc-d\">Posa di materiali isolanti sulle pareti esterne, in quota e senza impalcature.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-manutenzione-e-installazione-canne-fumarie/\"><span class=\"ex-svc-t\">Canne fumarie</span><span class=\"ex-svc-d\">Spazzolatura, controlli e montaggio, anche direttamente sul tetto.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/installazione-e-manutenzione-dissuasori-per-piccioni/\"><span class=\"ex-svc-t\">Dissuasori per piccioni</span><span class=\"ex-svc-d\">Sistemi anti-volatili installati e mantenuti per tenere lontani i volatili.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/montaggio-sistemi-di-sicurezza-su-fune/\"><span class=\"ex-svc-t\">Sistemi di sicurezza su fune</span><span class=\"ex-svc-d\">Linee vita e ancoraggi fissi per salire sul tetto in sicurezza.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/rimozione-materiale-pericolante/\"><span class=\"ex-svc-t\">Messa in sicurezza</span><span class=\"ex-svc-d\">Eliminazione immediata di parti instabili che rischiano di cadere.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/potatura-alberi/\"><span class=\"ex-svc-t\">Potatura alberi</span><span class=\"ex-svc-d\">Lavori sugli alberi alti o in spazi dove non si arriva con i mezzi.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-componenti-su-fune/\"><span class=\"ex-svc-t\">Pulizia componenti su fune</span><span class=\"ex-svc-d\">Pulizia di elementi in altezza, su qualsiasi tipo di edificio.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-pannelli-fotovoltaici/\"><span class=\"ex-svc-t\">Pulizia pannelli fotovoltaici</span><span class=\"ex-svc-d\">Lavaggio periodico per non perdere resa dall'impianto.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/pulizia-vetri/\"><span class=\"ex-svc-t\">Pulizia vetri in altezza</span><span class=\"ex-svc-d\">Vetrate di condomini, uffici e palazzi alti, senza bisogno di piattaforma.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a><a class=\"ex-svc\" href=\"/servizi/ristrutturazioni-balconi-e-facciate/\"><span class=\"ex-svc-t\">Ristrutturazioni balconi e facciate</span><span class=\"ex-svc-d\">Recupero di balconi e pareti, sia nell'aspetto sia nella parte strutturale.</span><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M4 12h15M13 6l6 6-6 6\"/></svg></a></div></div></section>"
  },
  {
    "id": "pricing",
    "nome": "Preventivo",
    "enabled": true,
    "html": "<section class=\"ex-band\" id=\"pricing\" aria-labelledby=\"pricing-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"pricing-title\">Sopralluogo e preventivo senza costi</h2><p>Ti basta compilare un modulo: la risposta arriva entro 24 ore, esclusi i festivi.</p></div><a class=\"ex-btn ex-btn-k\" href=\"/contatti/\" onclick=\"trackClick('edilextreme','preventivo','Preventivo',0)\">Chiedi un preventivo</a></div></section>"
  },
  {
    "id": "cta",
    "nome": "CTA finale",
    "enabled": false,
    "html": "<section class=\"ex-end\" aria-labelledby=\"cta-title\"><div class=\"ex-band-in\"><div><h2 class=\"ex-h2\" id=\"cta-title\">Hai un lavoro in quota da fare?</h2><p>Scrivici dal modulo: ti rispondiamo entro 24 ore, esclusi i festivi.</p></div><a class=\"ex-btn ex-btn-y\" href=\"/contatti/\">Chiedi un preventivo</a></div></section>"
  }
]